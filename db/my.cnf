# Widgetorium MySQL config, mounted at /etc/mysql/conf.d/widgetorium.cnf
#
# Every line here is a deliberate misconfiguration that supports vuln 4
# (file read/write via the injectable price/quantity API).

[mysqld]
# Empty secure_file_priv lets LOAD_FILE() and INTO OUTFILE touch any path the
# server user can reach. Production should set this to a single locked-down dir.
secure_file_priv=""

# Allow LOAD DATA LOCAL INFILE from the client side.
local_infile=1

# No sql_mode means no STRICT_TRANS_TABLES, so sloppy injected values are
# coerced instead of rejected, which keeps the injection payloads working.
sql_mode=""

# Keep the general log off by default, but make it trivial to switch on from a
# scenario if you want to show query logging.
general_log=0
general_log_file=/var/lib/mysql/general.log
