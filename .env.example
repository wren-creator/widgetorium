# Widgetorium lab configuration.
# Copy to .env (setup.sh does this for you) and edit if you need to.
# Every value below is a deliberate weakness toggle or a lab credential.
# "1" enables the vulnerability, "0" disables it so an instructor can take a
# whole bug class off the table for a graded exercise.

# --- database (internal network only, never published) ---
DB_HOST=db
DB_NAME=widgetorium
DB_USER=widgetorium
DB_PASS=widgetorium
MYSQL_ROOT_PASSWORD=root

# --- certificate / TLS scenario toggles ---
# EXPIRED_CERT=1 swaps the self-signed-mismatch cert for a long-expired one.
# The canonical way to run that scenario is the override file:
#   docker compose -f docker-compose.yml -f docker-compose.expired-cert.yml up -d
EXPIRED_CERT=0
# WEAK_TLS=1 enables TLS 1.0/1.1 and RC4/3DES/EXPORT ciphers (vuln 7).
WEAK_TLS=1
# SEND_HSTS=0 omits the Strict-Transport-Security header (vuln 8).
SEND_HSTS=0

# --- web application weakness toggles ---
# PLANT_GIT=1 exposes /admin/.git/ with a secret in its history (vuln 9).
PLANT_GIT=1
# VERBOSE_ERRORS=1 echoes stack traces and raw SQL in responses (vuln 14).
VERBOSE_ERRORS=1
# SECOND_ORDER_SINK=1 enables the admin report path that fires stored
# payloads from product names (vuln 3).
SECOND_ORDER_SINK=1
# WEAK_SESSIONS=1 mints predictable session tokens instead of random ones (vuln 13).
WEAK_SESSIONS=1

# --- ftp credentials (vuln 16) ---
FTP_USER=ftpuser
FTP_PASS=ftpuser
